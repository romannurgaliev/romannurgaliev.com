    "mutation": "stryker run",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "fast-check": "^4.10.2"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
